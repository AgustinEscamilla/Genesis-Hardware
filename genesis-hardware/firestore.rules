rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function esAdmin() {
      return autenticado()
        && request.auth.token.email is string
        && request.auth.token.email.matches('.*@admin\\.genesis\\.com$');
    }

    // Catalogo visible para frontend publico/cliente.
    match /catalogo/{productoId} {
      allow read: if true;
      allow create, update, delete: if esAdmin();
    }

    // Regla temporal para no romper otros modulos existentes.
    // Ajustar por coleccion cuando se endurezca seguridad.
    match /{documento=**} {
      allow read, write: if autenticado();
    }
  }
}
